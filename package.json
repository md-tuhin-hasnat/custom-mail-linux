{
  "name": "custom-mail-linux",
  "version": "1.0.0",
  "description": "Enterprise Linux Email Client built with Electron, Next.js, and CSS Modules",
  "main": "dist/main/main.js",
  "scripts": {
    "run": "./run.sh",
    "app:electron": "./run.sh --electron --seed",
    "app:electron:empty": "./run.sh --electron --no-seed",
    "app:browser": "./run.sh --browser --seed",
    "app:browser:empty": "./run.sh --browser --no-seed",
    "dev:next": "next dev -p 3000",
    "dev:electron": "wait-on tcp:3000 && electron .",
    "dev": "npm run build:main && concurrently -k \"npm run dev:next\" \"npm run dev:electron\"",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "next build",
    "build": "npm run build:renderer && npm run build:main",
    "start": "cross-env NODE_ENV=production electron .",
    "lint": "next lint"
  },
  "keywords": [
    "email",
    "electron",
    "nextjs",
    "linux",
    "outlook",
    "enterprise"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/dompurify": "^3.0.5",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "wait-on": "^9.5.1"
  }
}
